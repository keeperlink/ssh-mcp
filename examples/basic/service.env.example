# Private mode 0600 OUTSIDE the repository. Replace invalid credential placeholders.
# Docker administrators can inspect environment variables.
MCP_ISSUER=https://mcp.example.com
MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:443,localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=https://chatgpt.com
MCP_CIMD_CLIENT_ID=https://chatgpt.com/oauth/client.json
MCP_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
MCP_CIMD_VALIDATE_REMOTE=true
MCP_CONVERSATION_HEADER_NAME=X-OpenAI-Session
MCP_ENVIRONMENT=lab
MCP_LOGIN_KEY=REPLACE_ME
MCP_TOKEN_SIGNING_SECRET=REPLACE_ME
HISTORY_VIEWER_PASSWORD=REPLACE_ME
HISTORY_VIEWER_ENABLED=true
MCP_SSH_TOOLS_ENABLED=true
SSH_EXECUTOR_ENABLED=true
# Explicit authorization to run fixed host identity and sudo safety probes.
SSH_READINESS_AUTHORIZED=false
SSH_INVENTORY_FILE=/run/ssh-mcp/inventory.json
SSH_APPROVED_ALIASES=demo
SSH_JOBS_ENABLED=true
SSH_JOBS_DB=/var/lib/ssh-mcp/jobs.sqlite
SSH_JOBS_RETENTION_MONTHS=3
MCP_METRICS_ENABLED=false
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
