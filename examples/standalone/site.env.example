# Copy to examples/standalone/.env (Git-ignored).
MCP_PUBLIC_HOST=mcp.example.com
# Absolute operator-owned paths OUTSIDE the repository:
MCP_PRIVATE_ENV=/absolute/private/path/service.env
MCP_SSH_CONFIG_DIR=/absolute/private/path/ssh
# Dedicated private bridge; only its exact Caddy address is trusted.
# Choose an unused overall subnet. Docker assigns dynamic app IPs only from
# MCP_PROXY_DYNAMIC_RANGE; it MUST be inside the subnet and exclude Caddy.
# If customizing, update all three together (see docs/getting-started.md).
MCP_PROXY_SUBNET=172.30.244.0/28
MCP_PROXY_DYNAMIC_RANGE=172.30.244.8/29
MCP_CADDY_IP=172.30.244.2
