# Copy to examples/hardened/.env, never commit your live private configuration.
# Existing HTTPS reverse proxy MUST terminate TLS on the same Docker host.
MCP_LOCAL_PORT=8000
# Exact Docker bridge gateway through which the host proxy reaches the app.
# Change subnet and gateway together if they overlap your local networks.
MCP_BRIDGE_SUBNET=172.30.245.0/28
MCP_DOCKER_GATEWAY=172.30.245.1
MCP_PRIVATE_ENV=/absolute/private/path/service.env
MCP_SSH_CONFIG_DIR=/absolute/private/path/ssh
